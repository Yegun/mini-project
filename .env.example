# 비밀값은 이 파일이 아니라 .env 에 적는다. .env 는 Git 에 올리지 않는다. (연결 문자열·비밀번호는 채팅과 문서에도 쓰지 않는다)
# 아래는 이름과 형태만 적은 예시다. 실제 값은 backend/.env (또는 프로젝트 폴더의 .env) 에 적는다.
#
# 연결 문자열 형태:  postgresql://사용자이름:비밀번호@주소:포트/DB이름
#   내 컴퓨터 PostgreSQL 예)  postgresql://postgres:내비밀번호@localhost:5432/postgres
#   비밀번호에 @ : / 같은 기호가 있으면 %40 %3A %2F 처럼 바꿔 적는다.

# 시험용 DB (내 컴퓨터 PostgreSQL 16). 시험이 임시 schema 를 만들고 지운다. 운영 DB 를 넣지 않는다.
TEST_DATABASE_URL=postgresql://사용자이름:비밀번호@localhost:5432/DB이름

# 개발자 작업용 DB 계정. 표 만들기(migrate)·규칙표 채우기(init_db)·기한 다시 계산에만 쓴다 (앱 코드에서는 쓰지 않는다).
DATABASE_ADMIN_URL=postgresql://사용자이름:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 앱(API)이 쓰는 DB 계정. 규칙표 세 표는 읽기만 된다. (setup_roles 로 만든 계정)
DATABASE_URL=postgresql://앱계정이름:앱비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 앱 DB 계정을 만들 때 쓰는 이름과 비밀번호 (python -m app.db.setup_roles). DATABASE_URL 의 계정과 같아야 한다.
APP_DB_USER=앱계정이름
APP_DB_PASSWORD=앱비밀번호

# AI(Claude) 키. 사진 읽기와 음식 추천에서 서버만 쓴다. 값은 .env 에만 적고 Git 에 올리지 않는다 (D-132).
ANTHROPIC_API_KEY=키
# 쓸 모델 이름. 없으면 claude-haiku-5-5 를 쓴다 (D-131).
# AI_MODEL=claude-haiku-5-5
